DATABASE_URL="file:./clinic.db"
JWT_SECRET="change-this-to-a-strong-random-secret"

# License / clinical API (NestJS on license-server)
# Local testing:
# API_BASE_URL=http://localhost:4000/api
# Production (Vercel):
API_BASE_URL=https://clinic-license-six.vercel.app/api

# Meta WhatsApp Embedded Signup (Connect with Meta in Settings → WhatsApp)
# Create App → Facebook Login for Business → WhatsApp Embedded Signup config.
# App Secret stays in main process only — never expose to the renderer.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_CONFIG_ID=

# Optional fallbacks (prefer per-clinic Settings → WhatsApp)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
