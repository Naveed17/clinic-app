generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  LAB_TECHNICIAN
  PHARMACIST
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  REFUNDED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  OTHER
}

enum LabOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TokenStatus {
  WAITING
  IN_PROGRESS
  DONE
  SKIPPED
}

// ==========================================
// USER & DOCTOR MANAGEMENT
// ==========================================

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RECEPTIONIST)
  isActive     Boolean  @default(true)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments    Appointment[]
  doctorProfile   DoctorProfile?
  labOrders       LabOrder[]
  tokens          Token[]
  schedules       DoctorSchedule[]
  attendance      DoctorAttendance[]
  primaryPatients Patient[]        @relation("PatientPrimaryDoctor")

  @@index([lastName, firstName])
}

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  specialization  String
  qualification   String?
  experienceYears Int      @default(0)
  phone           String?
  bio             String?
  avatar          String?
  consultationFee Decimal @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorSchedule {
  id        String   @id @default(uuid())
  doctorId  String
  dayOfWeek Int // 0=Sun, 1=Mon, ..., 6=Sat
  startTime String // HH:MM
  endTime   String // HH:MM
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor User @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
}

model DoctorAttendance {
  id         String    @id @default(uuid())
  doctorId   String
  date       String // YYYY-MM-DD
  checkInAt  DateTime
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  doctor User @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([doctorId])
  @@index([date])
}

// ==========================================
// PATIENT MANAGEMENT
// ==========================================

model Patient {
  id                    String    @id @default(uuid())
  mrNumber              String    @unique
  firstName             String
  lastName              String?
  weight                Float?
  dateOfBirth           DateTime?
  gender                String?
  phone                 String?
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodGroup            String?
  allergies             String?
  chronicConditions     String?
  primaryDoctorId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  primaryDoctor User?             @relation("PatientPrimaryDoctor", fields: [primaryDoctorId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  invoices      Invoice[]
  labOrders     LabOrder[]
  documents     PatientDocument[]
  tokens        Token[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([mrNumber])
  @@index([primaryDoctorId])
}

model PatientDocument {
  id         String   @id @default(uuid())
  patientId  String
  name       String
  filePath   String
  mimeType   String
  size       Int      @default(0)
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// ==========================================
// APPOINTMENT & TOKEN SYSTEM
// ==========================================

model Appointment {
  id             String            @id @default(uuid())
  patientId      String
  providerId     String
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  notes          String?
  feeType        String            @default("PAID") // "PAID", "FREE", "HALF"
  recurrenceRule String? // e.g. "WEEKLY:4" = repeat weekly 4 times
  parentId       String? // original appointment id for recurring copies
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider User     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  invoice  Invoice?

  @@index([patientId, startsAt])
  @@index([providerId, startsAt])
  @@index([startsAt])
}

model Token {
  id          String      @id @default(uuid())
  tokenNumber Int
  date        String // YYYY-MM-DD
  patientId   String
  doctorId    String
  status      TokenStatus @default(WAITING)
  notes       String?
  reason      String?
  consultationFee Decimal    @default(0)
  feeDiscount     Decimal    @default(0)
  feeRefunded     Decimal    @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    User       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  labOrders LabOrder[]

  @@unique([date, tokenNumber, doctorId])
  @@index([date, doctorId])
  @@index([patientId])
}

// ==========================================
// BILLING & INVOICING (CLINIC)
// ==========================================

model Invoice {
  id            String        @id @default(uuid())
  patientId     String
  appointmentId String?       @unique
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  dueAt         DateTime?
  subtotal      Decimal       @default(0)
  discount      Decimal       @default(0)
  tax           Decimal       @default(0)
  total         Decimal       @default(0)
  amountPaid    Decimal       @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]

  @@index([patientId, createdAt])
  @@index([status, dueAt])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0)
  lineTotal   Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  amount    Decimal       @default(0)
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, paidAt])
  @@index([paidAt])
}

// ==========================================
// LAB MANAGEMENT
// ==========================================

model LabOrder {
  id          String         @id @default(uuid())
  patientId   String
  orderedById String
  tokenId     String?
  test        String
  status      LabOrderStatus @default(PENDING)
  result      String?
  notes       String?
  orderedAt   DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  orderedBy User        @relation(fields: [orderedById], references: [id], onDelete: Restrict)
  token     Token?      @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  reports   LabReport[]

  @@index([patientId])
  @@index([orderedById])
  @@index([tokenId])
  @@index([status])
}

model LabReport {
  id         String   @id @default(uuid())
  labOrderId String
  name       String
  filePath   String
  mimeType   String
  size       Int      @default(0)
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@index([labOrderId])
}

// ==========================================
// MEDICINE CATALOG (invoice / Rx picker)
// ==========================================

model Medicine {
  id            String   @id @default(uuid())
  name          String
  mg            Int?
  genericName   String?
  categoryId    String?
  barcode       String?  @unique
  unit          String   @default("Tablet")
  rackNumber    String?
  minStockAlert Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches  MedicineBatch[]

  @@index([name])
  @@index([genericName])
  @@index([barcode])
}

model MedicineBatch {
  id            String   @id @default(uuid())
  medicineId    String
  batchNumber   String
  expiryDate    DateTime
  purchasePrice Decimal  @default(0)
  salePrice     Decimal  @default(0)
  quantity      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([medicineId, batchNumber])
  @@index([expiryDate])
  @@index([quantity])
}
